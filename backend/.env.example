# ===== 筑安云环境配置模板（复制为 .env 后填写）=====
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=csu

# AI模式：true=内置模拟引擎(零API消耗) false=调用通义千问
MOCK_MODE=true
# 阿里云百炼(DashScope) API Key，https://open.bigmodel.cn 不适用，请用 bailian.console.aliyun.com 申请
DASHSCOPE_API_KEY=
QWEN_TEXT_MODEL=qwen-flash
QWEN_VL_MODEL=qwen-vl-plus
QWEN_EMBED_MODEL=text-embedding-v4
QWEN_ASR_MODEL=qwen3-asr-flash

# 注册验证码邮件（QQ 邮箱示例；SMTP_PASS 使用 SMTP 授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM=
